              "type": "integer",
              "minimum": 0
            },
            "applicable": {
              "type": "integer",
              "minimum": 0
            },
            "resolved": {
              "type": "integer",
              "minimum": 0
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "completeness": {
          "type": "object",
          "required": [
            "pass",
            "fail",
            "not-applicable",
            "unknown",
            "manual-review",
            "applicable",
            "resolved",
            "rules"
          ],
          "properties": {
